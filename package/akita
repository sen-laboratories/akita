# SPDX-FileCopyrightText: 2026 SEN Labs e.U.
#
# akita: Akita, the Tracker of SEN, instead of the stock Tracker of Haiku, and back.
#
#   akita enable     Akita instead of Tracker at every login (the default of the package: removes the file that "akita disable" made)
#   akita disable    the stock Tracker at every login (a file in ~/config/settings/launch that switches the services of the launch daemon back)
#   akita start      switch now: stops the stock Tracker and starts Akita
#   akita stop       switch back now: quits Akita and starts the stock Tracker
#   akita status     what is installed, enabled and running
#
# The package has a file for the launch daemon (data/user_launch/akita) that disables the service of Tracker and starts Akita in its place at login.
# The files of the user are read after those of the packages, so a file of the user can undo that. Both are services, which the launch daemon starts
# again when they quit: so they are stopped as services (launch_roster). Akita has the signature of Tracker (only one of them can run).

TRACKER_SERVICE=x-vnd.be-trak
AKITA_SERVICE=x-vnd.sen-labs.akita
SIGNATURE=application/x-vnd.Be-TRAK

settings=$(finddir B_USER_SETTINGS_DIRECTORY)
override=${AKITA_OVERRIDE:-$settings/launch/akita}		# (the variable is for tests)
bootscript=${AKITA_BOOTSCRIPT:-$settings/boot/UserBootscript}

# the Akita that is installed (for the system or for the user)
find_akita()
{
	local path
	for path in "$(finddir B_SYSTEM_APPS_DIRECTORY)/Akita/Akita" "$(finddir B_USER_APPS_DIRECTORY)/Akita/Akita"; do
		if [ -x "$path" ]; then
			echo "$path"
			return 0
		fi
	done
	return 1
}

# the services that the launch daemon knows (the disabled one of Tracker is not among them)
has_service()
{
	launch_roster list 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | grep -q "^ *$1 "
}

service_running()
{
	launch_roster list 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | grep -q "^ *$1 .*running"
}

# is a Tracker (the stock one or Akita) running? (its signature is the same)
tracker_running()
{
	hey "$SIGNATURE" COUNT Window >/dev/null 2>&1
}

wait_until_gone()
{
	local i
	for i in $(seq 1 20); do
		tracker_running || return 0
		sleep 0.5
	done
}

enabled()
{
	[ ! -f "$override" ]
}

enable()
{
	if enabled; then
		echo "Akita is already enabled."
		return 0
	fi
	rm -f "$override"
	rmdir "$(dirname "$override")" 2>/dev/null
	echo "Akita is enabled: it replaces Tracker at the next login (or now: akita start)."
}

disable()
{
	if ! enabled; then
		echo "Akita is not enabled."
		return 0
	fi
	mkdir -p "$(dirname "$override")"
	cat > "$override" <<'FILE'
# Written by "akita disable" ("akita enable" removes it): the stock Tracker instead of Akita at login. This file is read after the one of the package.
service x-vnd.sen-labs.akita {
	disabled true
}
service x-vnd.Be-TRAK {
	disabled false
}
FILE
	echo "Akita is disabled: the stock Tracker is started at the next login."
}

# The old versions of the package started Akita from a block in the UserBootscript: it goes (the launch daemon does it now).
remove_old_hook()
{
	local begin="# >>> Akita >>>" end="# <<< Akita <<<"
	[ -f "$bootscript" ] && grep -qF "$begin" "$bootscript" || return 0
	local temp
	temp=$(mktemp "${TMPDIR:-/tmp}/akita.XXXXXX") || return 1
	awk -v begin="$begin" -v end="$end" '
		index($0, begin) == 1 { skip = 1 }
		!skip { lines[++n] = $0 }
		skip && index($0, end) == 1 { skip = 0 }
		END {
			while (n > 0 && lines[n] == "") n--
			for (i = 1; i <= n; i++) print lines[i]
		}' "$bootscript" > "$temp" && cat "$temp" > "$bootscript"
	rm -f "$temp"
	echo "the old block for Akita is removed from the UserBootscript."
}

start()
{
	local akita
	akita=$(find_akita) || { echo "Akita is not installed." >&2; return 1; }

	launch_roster stop $TRACKER_SERVICE >/dev/null 2>&1
	launch_roster stop $AKITA_SERVICE >/dev/null 2>&1
	hey "$SIGNATURE" quit >/dev/null 2>&1
	wait_until_gone
	# as a service if there is one (the launch daemon then starts it again if it quits), else by hand
	if ! { has_service $AKITA_SERVICE && launch_roster start $AKITA_SERVICE >/dev/null 2>&1; }; then
		"$akita" >/dev/null 2>&1 &
	fi
	echo "Akita started."
}

stop()
{
	launch_roster stop $AKITA_SERVICE >/dev/null 2>&1
	hey "$SIGNATURE" quit >/dev/null 2>&1
	wait_until_gone
	if ! { has_service $TRACKER_SERVICE && launch_roster start $TRACKER_SERVICE >/dev/null 2>&1; }; then
		"$(finddir B_SYSTEM_DIRECTORY)/Tracker" >/dev/null 2>&1 &
	fi
	echo "The stock Tracker is started."
}

status()
{
	local akita
	if akita=$(find_akita); then echo "installed:  $akita"; else echo "installed:  no"; fi
	if enabled; then echo "enabled:    yes (at login)"; else echo "enabled:    no ($override)"; fi
	if service_running $TRACKER_SERVICE; then echo "running:    the stock Tracker (service $TRACKER_SERVICE)"; \
	elif service_running $AKITA_SERVICE; then echo "running:    Akita (service $AKITA_SERVICE)"; \
	elif tracker_running; then echo "running:    Akita (or a Tracker that was started by hand)"; else echo "running:    no Tracker"; fi
}

case "$1" in
	enable) enable;;
	disable) disable;;
	# (the block of the old versions did "akita start --boot": the launch daemon does that now, so it does nothing)
	start) [ "$2" = --boot ] || start;;
	stop) stop;;
	status) status;;
	cleanup) remove_old_hook;;
	*)
		sed -n '6,12p' "$0" | sed 's/^# \{0,1\}//'
		[ -z "$1" ] || [ "$1" = --help ] || exit 1;;
esac
